generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(uuid())
  email           String?             @unique
  phone           String?             @unique
  passwordHash    String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  evidence        Evidence[]
  trustedContacts TrustedContact[]
  sosAlerts       SosAlert[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  notifications   SosNotification[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Evidence {
  id           String   @id @default(uuid())
  userId       String
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  sha256       String
  capturedAt   DateTime?
  uploadedAt   DateTime @default(now())
  encrypted    Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, uploadedAt])
}

model TrustedContact {
  id String @id @default(uuid())
  userId String
  name String
  phone String
  relationship String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications SosNotification[]
  @@index([userId])
}

model SosAlert {
  id String @id @default(uuid())
  userId String
  latitude Decimal?
  longitude Decimal?
  message String?
  status String @default("TRIGGERED")
  triggeredAt DateTime @default(now())
  resolvedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications SosNotification[]
  @@index([userId, triggeredAt])
}

model SosNotification {
  id              String         @id @default(uuid())
  alertId         String
  userId          String
  contactId       String
  channel         String         @default("PENDING")
  status          String         @default("PENDING")
  errorMessage    String?
  createdAt       DateTime       @default(now())
  sentAt          DateTime?
  alert           SosAlert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact         TrustedContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([alertId, status])
  @@index([userId, createdAt])
}

model AuditLog {
  id String @id @default(uuid())
  userId String
  action String
  resourceType String?
  resourceId String?
  ipAddress String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
